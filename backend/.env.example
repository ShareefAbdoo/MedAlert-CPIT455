# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Go to: Supabase dashboard → Project Settings → Database → Connection string → URI
# Use the "Session mode" URI (port 5432) for the backend server.
# Use the "Transaction mode" URI (port 6543) if you add a serverless/edge layer later.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Path to your downloaded service-account JSON file
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=alerts@medalert.local
SENDGRID_FROM_NAME=MedAlert System

# ── Alerts ────────────────────────────────────────────────────────────────────
# Minutes grace period before a pending dose is marked "missed"
ALERT_GRACE_MINUTES=15

# Clinic operating hours (24-hour clock, inclusive start / exclusive end)
# Alerts outside these hours are queued and sent when the clinic opens
CLINIC_OPEN_HOUR=7
CLINIC_CLOSE_HOUR=23

# ── Security ──────────────────────────────────────────────────────────────────
# Used for signing delete-confirmation tokens
JWT_SECRET=replace_with_at_least_32_random_characters_here
